# Copie para .env para uso local. O .env é ignorado pelo Git.
# Este arquivo não pode conter segredos. Tokens reais vão para o cofre do sistema,
# pela interface do aplicativo (seção 24.3 do planejamento).

# Nível de log: trace, debug, info, warn, error ou fatal.
APP_LOG_LEVEL=info

# Abre o DevTools do Electron. Use true só em desenvolvimento.
APP_DEVTOOLS=false

# Adaptador de agente. mock é o agente simulado, o único desta etapa.
APP_AGENT_ADAPTER=mock

# Raiz dos worktrees das missões. Vazio usa o padrão <home>/ProjectHub/worktrees.
APP_WORKTREES_ROOT=
